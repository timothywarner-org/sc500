// Hypothesis: someone is reading full ServiceHub parts exports without a service case.
// Start wide (every export in the window), then let the case column split normal from odd.
ServiceHubAudit_CL
| where TimeGenerated > ago(7d)
| where Operation == "PartsExportRead"
| summarize Exports = count(),
            WithoutCase = countif(isempty(CaseId)),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated),
            SourceIps = make_set(ClientIp)
            by Actor
| extend NoCasePercent = round(100.0 * WithoutCase / Exports, 1)
| order by WithoutCase desc
